

API_KEY_SECRET=
SUPABASE_SECRET_KEY=
CERTIFICATIONS_SERVICE_KEY=
SUPPORT_COUCHDB_URL=
SUPPORT_COUCHDB_USERNAME=
SUPPORT_COUCHDB_PASSWORD=
SUPPORT_COUCHDB_DATABASE=support_tickets

FSM_APP_NAME=api_for_apps
FSM_APP_KEY=

# HMAC secret shared with the official Cortex Web App build. It computes
# X-Asodya-App-Proof over f"{date_utc}:{app_id}" with this secret; the
# cortex proxy (src/presentation/routes/cortex_route.py) verifies it to
# grant unlimited usage instead of the strict 5-requests/day script cap.
CORTEX_PROOF_SECRET=

# Browser origin the Cortex Web App serves from in this deployment's
# local/dev environment (e.g. http://localhost:PORT if launched with
# `flutter run -d chrome --web-port=PORT`). Required for the SSO exchange
# (POST /v1/exchange) to accept local cortex requests; leave blank in
# production, where only the hardcoded cortex.asodya.com origin is used.
CORTEX_WEB_LOCAL_ORIGIN=
